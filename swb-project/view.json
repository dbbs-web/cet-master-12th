[
  {
    "xmlName": "activity_splash.xml",
    "type": "LinearLayout",
    "id": "splash_root",
    "orientation": "vertical",
    "gravity": "center",
    "backgroundColor": "#1E3A8A",
    "children": [
      {
        "type": "ImageView",
        "id": "splash_logo",
        "src": "@drawable/ic_app_logo",
        "scaleType": "centerInside",
        "layout": {"width": "200dp", "height": "200dp"}
      },
      {
        "type": "TextView",
        "id": "splash_title",
        "text": "CET Master 12th",
        "textSize": "28sp",
        "textColor": "#FFFFFF",
        "textStyle": "bold",
        "layout": {"width": "wrap_content", "height": "wrap_content", "marginTop": "16dp"}
      },
      {
        "type": "TextView",
        "id": "splash_subtitle",
        "text": "Your Complete Study Companion",
        "textSize": "14sp",
        "textColor": "#B3B3B3",
        "layout": {"width": "wrap_content", "height": "wrap_content", "marginTop": "8dp"}
      },
      {
        "type": "ProgressBar",
        "id": "splash_progress",
        "style": "?attr/progressBarStyle",
        "layout": {"width": "50dp", "height": "50dp", "marginTop": "40dp"}
      }
    ]
  },
  {
    "xmlName": "activity_user_login.xml",
    "type": "LinearLayout",
    "id": "login_root",
    "orientation": "vertical",
    "backgroundColor": "#FFFFFF",
    "children": [
      {
        "type": "LinearLayout",
        "id": "login_header",
        "orientation": "vertical",
        "gravity": "center",
        "backgroundColor": "#1E3A8A",
        "layout": {"width": "match_parent", "height": "200dp"},
        "children": [
          {"type": "ImageView", "id": "login_logo", "src": "@drawable/ic_app_logo", "layout": {"width": "100dp", "height": "100dp"}},
          {"type": "TextView", "id": "login_title", "text": "User Login", "textSize": "24sp", "textColor": "#FFFFFF", "textStyle": "bold", "layout": {"width": "wrap_content", "height": "wrap_content", "marginTop": "8dp"}}
        ]
      },
      {
        "type": "ScrollView",
        "id": "login_scroll",
        "layout": {"width": "match_parent", "height": "0dp", "weight": "1"},
        "children": [
          {
            "type": "LinearLayout",
            "id": "login_content",
            "orientation": "vertical",
            "padding": "24dp",
            "layout": {"width": "match_parent", "height": "wrap_content"},
            "children": [
              {
                "type": "EditText",
                "id": "login_email",
                "hint": "Email Address",
                "inputType": "textEmailAddress",
                "layout": {"width": "match_parent", "height": "48dp", "marginBottom": "16dp"}
              },
              {
                "type": "EditText",
                "id": "login_password",
                "hint": "Password",
                "inputType": "textPassword",
                "layout": {"width": "match_parent", "height": "48dp", "marginBottom": "24dp"}
              },
              {
                "type": "Button",
                "id": "login_btn",
                "text": "Login",
                "backgroundColor": "#3B82F6",
                "textColor": "#FFFFFF",
                "layout": {"width": "match_parent", "height": "48dp", "marginBottom": "16dp"}
              },
              {
                "type": "LinearLayout",
                "id": "login_footer",
                "orientation": "horizontal",
                "gravity": "center",
                "layout": {"width": "match_parent", "height": "wrap_content"},
                "children": [
                  {"type": "TextView", "id": "login_signup_text", "text": "Don't have an account? ", "textSize": "14sp", "textColor": "#666666"},
                  {"type": "TextView", "id": "login_signup_link", "text": "Register", "textSize": "14sp", "textColor": "#3B82F6", "textStyle": "bold"}
                ]
              }
            ]
          }
        ]
      }
    ]
  },
  {
    "xmlName": "activity_user_register.xml",
    "type": "LinearLayout",
    "id": "register_root",
    "orientation": "vertical",
    "backgroundColor": "#FFFFFF",
    "children": [
      {
        "type": "LinearLayout",
        "id": "register_header",
        "orientation": "horizontal",
        "layout": {"width": "match_parent", "height": "56dp", "backgroundColor": "#1E3A8A"},
        "children": [
          {"type": "ImageButton", "id": "register_back", "src": "@drawable/ic_back", "layout": {"width": "56dp", "height": "56dp"}},
          {"type": "TextView", "id": "register_title", "text": "Register", "textSize": "20sp", "textColor": "#FFFFFF", "textStyle": "bold", "layout": {"width": "0dp", "height": "wrap_content", "weight": "1", "gravity": "center_vertical", "marginLeft": "8dp"}}
        ]
      },
      {
        "type": "ScrollView",
        "id": "register_scroll",
        "layout": {"width": "match_parent", "height": "match_parent"},
        "children": [
          {
            "type": "LinearLayout",
            "id": "register_content",
            "orientation": "vertical",
            "padding": "24dp",
            "layout": {"width": "match_parent", "height": "wrap_content"},
            "children": [
              {"type": "EditText", "id": "register_name", "hint": "Full Name", "layout": {"width": "match_parent", "height": "48dp", "marginBottom": "16dp"}},
              {"type": "EditText", "id": "register_email", "hint": "Email Address", "inputType": "textEmailAddress", "layout": {"width": "match_parent", "height": "48dp", "marginBottom": "16dp"}},
              {"type": "EditText", "id": "register_phone", "hint": "Phone Number", "inputType": "phone", "layout": {"width": "match_parent", "height": "48dp", "marginBottom": "16dp"}},
              {"type": "EditText", "id": "register_password", "hint": "Password", "inputType": "textPassword", "layout": {"width": "match_parent", "height": "48dp", "marginBottom": "16dp"}},
              {"type": "EditText", "id": "register_confirm_password", "hint": "Confirm Password", "inputType": "textPassword", "layout": {"width": "match_parent", "height": "48dp", "marginBottom": "24dp"}},
              {"type": "Button", "id": "register_btn", "text": "Register", "backgroundColor": "#3B82F6", "textColor": "#FFFFFF", "layout": {"width": "match_parent", "height": "48dp"}}
            ]
          }
        ]
      }
    ]
  },
