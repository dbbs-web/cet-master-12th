  {
    "xmlName": "activity_user_dashboard.xml",
    "type": "LinearLayout",
    "id": "dashboard_root",
    "orientation": "vertical",
    "backgroundColor": "#FFFFFF",
    "children": [
      {
        "type": "LinearLayout",
        "id": "dashboard_header",
        "orientation": "horizontal",
        "gravity": "center_vertical",
        "backgroundColor": "#1E3A8A",
        "padding": "16dp",
        "layout": {"width": "match_parent", "height": "56dp"},
        "children": [
          {"type": "TextView", "id": "dashboard_title", "text": "CET Master", "textSize": "20sp", "textColor": "#FFFFFF", "textStyle": "bold", "layout": {"width": "0dp", "height": "wrap_content", "weight": "1"}},
          {"type": "ImageButton", "id": "dashboard_search", "src": "@drawable/ic_search", "layout": {"width": "40dp", "height": "40dp", "marginRight": "8dp"}},
          {"type": "ImageButton", "id": "dashboard_settings", "src": "@drawable/ic_settings", "layout": {"width": "40dp", "height": "40dp"}}
        ]
      },
      {
        "type": "ScrollView",
        "id": "dashboard_scroll",
        "layout": {"width": "match_parent", "height": "0dp", "weight": "1"},
        "children": [
          {
            "type": "LinearLayout",
            "id": "dashboard_content",
            "orientation": "vertical",
            "padding": "16dp",
            "layout": {"width": "match_parent", "height": "wrap_content"},
            "children": [
              {
                "type": "LinearLayout",
                "id": "dashboard_user_card",
                "orientation": "horizontal",
                "gravity": "center_vertical",
                "backgroundColor": "#E0E7FF",
                "padding": "16dp",
                "layout": {"width": "match_parent", "height": "80dp", "marginBottom": "16dp", "cornerRadius": "8dp"},
                "children": [
                  {"type": "ImageView", "id": "dashboard_avatar", "src": "@drawable/ic_user", "layout": {"width": "60dp", "height": "60dp"}},
                  {
                    "type": "LinearLayout",
                    "id": "dashboard_user_info",
                    "orientation": "vertical",
                    "layout": {"width": "0dp", "height": "wrap_content", "weight": "1", "marginLeft": "16dp"},
                    "children": [
                      {"type": "TextView", "id": "dashboard_user_name", "text": "Welcome, User", "textSize": "16sp", "textColor": "#1E3A8A", "textStyle": "bold"},
                      {"type": "TextView", "id": "dashboard_user_email", "text": "user@example.com", "textSize": "12sp", "textColor": "#666666", "layout": {"width": "wrap_content", "height": "wrap_content", "marginTop": "4dp"}}
                    ]
                  }
                ]
              },
              {
                "type": "GridLayout",
                "id": "dashboard_subjects",
                "columnCount": "2",
                "layout": {"width": "match_parent", "height": "wrap_content", "marginBottom": "16dp"},
                "children": [
                  {"type": "CardView", "id": "subject_physics", "backgroundColor": "#3B82F6", "layout": {"width": "0dp", "height": "120dp", "weight": "1", "margin": "8dp"}, "children": [{"type": "TextView", "text": "Physics", "textSize": "18sp", "textColor": "#FFFFFF", "textStyle": "bold", "layout": {"width": "match_parent", "height": "match_parent", "gravity": "center"}}]},
                  {"type": "CardView", "id": "subject_chemistry", "backgroundColor": "#10B981", "layout": {"width": "0dp", "height": "120dp", "weight": "1", "margin": "8dp"}, "children": [{"type": "TextView", "text": "Chemistry", "textSize": "18sp", "textColor": "#FFFFFF", "textStyle": "bold", "layout": {"width": "match_parent", "height": "match_parent", "gravity": "center"}}]},
                  {"type": "CardView", "id": "subject_math", "backgroundColor": "#F59E0B", "layout": {"width": "0dp", "height": "120dp", "weight": "1", "margin": "8dp"}, "children": [{"type": "TextView", "text": "Mathematics", "textSize": "18sp", "textColor": "#FFFFFF", "textStyle": "bold", "layout": {"width": "match_parent", "height": "match_parent", "gravity": "center"}}]},
                  {"type": "CardView", "id": "subject_biology", "backgroundColor": "#8B5CF6", "layout": {"width": "0dp", "height": "120dp", "weight": "1", "margin": "8dp"}, "children": [{"type": "TextView", "text": "Biology", "textSize": "18sp", "textColor": "#FFFFFF", "textStyle": "bold", "layout": {"width": "match_parent", "height": "match_parent", "gravity": "center"}}]}
                ]
              },
              {
                "type": "LinearLayout",
                "id": "dashboard_quick_links",
                "orientation": "horizontal",
                "layout": {"width": "match_parent", "height": "wrap_content"},
                "children": [
                  {"type": "CardView", "id": "quick_notes", "layout": {"width": "0dp", "height": "80dp", "weight": "1", "margin": "8dp"}, "children": [{"type": "LinearLayout", "orientation": "vertical", "gravity": "center", "layout": {"width": "match_parent", "height": "match_parent"}, "children": [{"type": "ImageView", "src": "@drawable/ic_notes", "layout": {"width": "32dp", "height": "32dp"}}, {"type": "TextView", "text": "Notes", "textSize": "12sp", "layout": {"width": "wrap_content", "height": "wrap_content", "marginTop": "4dp"}}]}]},
                  {"type": "CardView", "id": "quick_mcq", "layout": {"width": "0dp", "height": "80dp", "weight": "1", "margin": "8dp"}, "children": [{"type": "LinearLayout", "orientation": "vertical", "gravity": "center", "layout": {"width": "match_parent", "height": "match_parent"}, "children": [{"type": "ImageView", "src": "@drawable/ic_quiz", "layout": {"width": "32dp", "height": "32dp"}}, {"type": "TextView", "text": "MCQ Test", "textSize": "12sp", "layout": {"width": "wrap_content", "height": "wrap_content", "marginTop": "4dp"}}]}]},
                  {"type": "CardView", "id": "quick_papers", "layout": {"width": "0dp", "height": "80dp", "weight": "1", "margin": "8dp"}, "children": [{"type": "LinearLayout", "orientation": "vertical", "gravity": "center", "layout": {"width": "match_parent", "height": "match_parent"}, "children": [{"type": "ImageView", "src": "@drawable/ic_paper", "layout": {"width": "32dp", "height": "32dp"}}, {"type": "TextView", "text": "Papers", "textSize": "12sp", "layout": {"width": "wrap_content", "height": "wrap_content", "marginTop": "4dp"}}]}]}
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "BottomNavigationView",
        "id": "dashboard_bottom_nav",
        "layout": {"width": "match_parent", "height": "56dp"},
        "items": [
          {"id": "nav_home", "title": "Home", "icon": "@drawable/ic_home"},
          {"id": "nav_bookmarks", "title": "Bookmarks", "icon": "@drawable/ic_bookmark"},
          {"id": "nav_downloads", "title": "Downloads", "icon": "@drawable/ic_download"},
          {"id": "nav_profile", "title": "Profile", "icon": "@drawable/ic_profile"}
        ]
      }
    ]
  },
  {
    "xmlName": "activity_chapter_notes.xml",
    "type": "LinearLayout",
    "id": "notes_root",
    "orientation": "vertical",
    "backgroundColor": "#FFFFFF",
    "children": [
      {
        "type": "LinearLayout",
        "id": "notes_header",
        "orientation": "horizontal",
        "gravity": "center_vertical",
        "backgroundColor": "#1E3A8A",
        "padding": "16dp",
        "layout": {"width": "match_parent", "height": "56dp"},
        "children": [
          {"type": "ImageButton", "id": "notes_back", "src": "@drawable/ic_back", "layout": {"width": "40dp", "height": "40dp"}},
          {"type": "TextView", "id": "notes_title", "text": "Physics Notes", "textSize": "18sp", "textColor": "#FFFFFF", "textStyle": "bold", "layout": {"width": "0dp", "height": "wrap_content", "weight": "1", "marginLeft": "8dp"}}
        ]
      },
      {
        "type": "RecyclerView",
        "id": "notes_recycler",
        "layout": {"width": "match_parent", "height": "match_parent"},
        "items": [
          {"type": "CardView", "layout": {"width": "match_parent", "height": "100dp", "margin": "8dp"}, "children": [{"type": "LinearLayout", "orientation": "vertical", "padding": "12dp", "layout": {"width": "match_parent", "height": "match_parent"}, "children": [{"type": "TextView", "text": "Chapter 1: Introduction to Physics", "textSize": "16sp", "textColor": "#1E3A8A", "textStyle": "bold"}, {"type": "TextView", "text": "Tap to view detailed notes and concepts", "textSize": "12sp", "textColor": "#666666", "layout": {"width": "wrap_content", "height": "wrap_content", "marginTop": "4dp"}}]}]}
        ]
      }
    ]
  },
  {
    "xmlName": "activity_pdf_viewer.xml",
    "type": "LinearLayout",
    "id": "pdf_root",
    "orientation": "vertical",
    "backgroundColor": "#FFFFFF",
    "children": [
      {
        "type": "LinearLayout",
        "id": "pdf_header",
        "orientation": "horizontal",
        "gravity": "center_vertical",
        "backgroundColor": "#1E3A8A",
        "padding": "16dp",
        "layout": {"width": "match_parent", "height": "56dp"},
        "children": [
          {"type": "ImageButton", "id": "pdf_back", "src": "@drawable/ic_back", "layout": {"width": "40dp", "height": "40dp"}},
          {"type": "TextView", "id": "pdf_title", "text": "PDF Document", "textSize": "16sp", "textColor": "#FFFFFF", "textStyle": "bold", "layout": {"width": "0dp", "height": "wrap_content", "weight": "1", "marginLeft": "8dp"}},
          {"type": "ImageButton", "id": "pdf_bookmark", "src": "@drawable/ic_bookmark", "layout": {"width": "40dp", "height": "40dp"}}
