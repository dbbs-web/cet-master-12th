  {
    "xmlName": "activity_mcq_test.xml",
    "type": "LinearLayout",
    "id": "mcq_root",
    "orientation": "vertical",
    "backgroundColor": "#FFFFFF",
    "children": [
      {
        "type": "LinearLayout",
        "id": "mcq_header",
        "orientation": "horizontal",
        "gravity": "center_vertical",
        "backgroundColor": "#1E3A8A",
        "padding": "16dp",
        "layout": {"width": "match_parent", "height": "56dp"},
        "children": [
          {"type": "TextView", "id": "mcq_timer", "text": "10:00", "textSize": "18sp", "textColor": "#FFFFFF", "textStyle": "bold", "layout": {"width": "wrap_content", "height": "wrap_content"}},
          {"type": "TextView", "id": "mcq_progress", "text": "Q 1/20", "textSize": "14sp", "textColor": "#E0E7FF", "layout": {"width": "0dp", "height": "wrap_content", "weight": "1", "gravity": "center"}},
          {"type": "ImageButton", "id": "mcq_exit", "src": "@drawable/ic_close", "layout": {"width": "40dp", "height": "40dp"}}
        ]
      },
      {
        "type": "ScrollView",
        "id": "mcq_scroll",
        "layout": {"width": "match_parent", "height": "0dp", "weight": "1"},
        "children": [
          {
            "type": "LinearLayout",
            "id": "mcq_content",
            "orientation": "vertical",
            "padding": "16dp",
            "layout": {"width": "match_parent", "height": "wrap_content"},
            "children": [
              {"type": "TextView", "id": "mcq_question", "text": "What is the SI unit of force?", "textSize": "16sp", "textColor": "#1E3A8A", "textStyle": "bold", "layout": {"width": "match_parent", "height": "wrap_content", "marginBottom": "24dp"}},
              {"type": "RadioButton", "id": "mcq_option_a", "text": "A) Joule", "layout": {"width": "match_parent", "height": "48dp", "marginBottom": "8dp"}},
              {"type": "RadioButton", "id": "mcq_option_b", "text": "B) Newton", "layout": {"width": "match_parent", "height": "48dp", "marginBottom": "8dp"}},
              {"type": "RadioButton", "id": "mcq_option_c", "text": "C) Pascal", "layout": {"width": "match_parent", "height": "48dp", "marginBottom": "8dp"}},
              {"type": "RadioButton", "id": "mcq_option_d", "text": "D) Watt", "layout": {"width": "match_parent", "height": "48dp", "marginBottom": "24dp"}}
            ]
          }
        ]
      },
      {
        "type": "LinearLayout",
        "id": "mcq_buttons",
        "orientation": "horizontal",
        "padding": "16dp",
        "layout": {"width": "match_parent", "height": "56dp"},
        "children": [
          {"type": "Button", "id": "mcq_prev_btn", "text": "Previous", "layout": {"width": "0dp", "height": "48dp", "weight": "1", "marginRight": "8dp"}},
          {"type": "Button", "id": "mcq_next_btn", "text": "Next", "backgroundColor": "#3B82F6", "textColor": "#FFFFFF", "layout": {"width": "0dp", "height": "48dp", "weight": "1", "marginLeft": "8dp"}}
        ]
      }
    ]
  },
  {
    "xmlName": "activity_profile.xml",
    "type": "LinearLayout",
    "id": "profile_root",
    "orientation": "vertical",
    "backgroundColor": "#FFFFFF",
    "children": [
      {
        "type": "LinearLayout",
        "id": "profile_header",
        "orientation": "vertical",
        "gravity": "center",
        "backgroundColor": "#1E3A8A",
        "padding": "16dp",
        "layout": {"width": "match_parent", "height": "200dp"},
        "children": [
          {"type": "ImageView", "id": "profile_avatar", "src": "@drawable/ic_user", "layout": {"width": "100dp", "height": "100dp"}},
          {"type": "TextView", "id": "profile_name", "text": "User Name", "textSize": "20sp", "textColor": "#FFFFFF", "textStyle": "bold", "layout": {"width": "wrap_content", "height": "wrap_content", "marginTop": "8dp"}},
          {"type": "TextView", "id": "profile_email", "text": "user@example.com", "textSize": "12sp", "textColor": "#E0E7FF", "layout": {"width": "wrap_content", "height": "wrap_content", "marginTop": "4dp"}}
        ]
      },
      {
        "type": "ScrollView",
        "id": "profile_scroll",
        "layout": {"width": "match_parent", "height": "0dp", "weight": "1"},
        "children": [
          {
            "type": "LinearLayout",
            "id": "profile_content",
            "orientation": "vertical",
            "padding": "16dp",
            "layout": {"width": "match_parent", "height": "wrap_content"},
